	<!-- Finder services: right-click a file or folder in Finder and choose
	     Services.

	     NSMessage names the method AppleScript would use; TyZip does not run
	     scripts, so the handler is registered in code from NSServiceProvider,
	     and the reply is sent from there. The message names still have to exist
	     and be unique.

	     Do NOT add NSReturnTypes here. With a return type the service becomes a
	     filter service, and the Services menu only shows services whose data
	     can be provided *and received* by the current responder. Finder's file
	     selection can provide files but has nothing that can receive a string,
	     so every TyZip item disappeared from the right-click menu (ticket 35). -->
	<key>NSServices</key>
	<array>
		<dict>
			<key>NSMenuItem</key>
			<dict>
				<key>default</key>
				<string>TyZip: Add to Archive…</string>
			</dict>
			<key>NSMessage</key>
			<string>compressDialog</string>
			<key>NSPortName</key>
			<string>TyZip</string>
			<key>NSSendFileTypes</key>
			<array>
				<string>public.item</string>
			</array>
			<!-- Finder also puts the plain POSIX paths on the service pasteboard
			     under the legacy filenames type. Reading only public.file-url is not
			     enough: it can be a file reference URL (file:///.file/id=...) whose
			     path is not a usable file name (ticket 36). -->
			<key>NSSendTypes</key>
			<array>
				<string>NSFilenamesPboardType</string>
			</array>
			<key>NSRequiredContext</key>
			<dict>
				<key>NSApplicationIdentifier</key>
				<string>com.apple.finder</string>
			</dict>
		</dict>
		<dict>
