+/* TyZip: the official POSIX build has no code page tables -- every conversion
+   ends in UTF-8 or a byte-for-byte fallback, so a ZIP name written in a
+   Windows code page (GBK and friends) can neither be read nor written. These
+   helpers add the code pages the ZIP name-encoding setting offers, through the
+   system iconv. Only those explicit code pages take this path; CP_ACP,
+   CP_OEMCP and CP_UTF8 keep the original behaviour. */
+static bool TzIconvName(UINT codePage, const char *&name)
+{
+  switch (codePage)
+  {
+    case 936:   name = "CP936"; return true;
+    case 54936: name = "GB18030"; return true;
+    case 950:   name = "BIG5"; return true;
+    case 932:   name = "CP932"; return true;
+    case 949:   name = "CP949"; return true;
+    case 1252:  name = "CP1252"; return true;
+    case 28591: name = "ISO-8859-1"; return true;
+    default: return false;
+  }
+}
+
+static bool TzIconvConvert(const char *fromName, const char *toName,
+    const char *src, size_t srcLen, AString &dest)
+{
+  dest.Empty();
+  if (srcLen == 0)
+    return true;
+  iconv_t cd = iconv_open(toName, fromName);
+  if (cd == (iconv_t)-1)
+    return false;
+  /* An entry name is at most 64 KB; 6x covers the worst expansion of either
+     direction. A larger result is reported as a failure, not truncated. */
+  const size_t cap = srcLen * 6 + 64;
+  char *out = dest.GetBuf((unsigned)cap);
+  char *inPtr = const_cast<char *>(src);
+  size_t inLeft = srcLen;
+  char *outPtr = out;
+  size_t outLeft = cap;
+  const size_t r = iconv(cd, &inPtr, &inLeft, &outPtr, &outLeft);
+  iconv_close(cd);
+  if (r == (size_t)-1 || inLeft != 0)
+  {
+    dest.ReleaseBuf_SetEnd(0);
+    return false;
+  }
+  dest.ReleaseBuf_SetEnd((unsigned)(outPtr - out));
+  return true;
+}
+
+static bool TzMBToU8(const AString &src, UINT codePage, AString &u8)
+{
+  const char *name = NULL;
+  if (!TzIconvName(codePage, name))
+    return false;
+  return TzIconvConvert(name, "UTF-8", src.Ptr(), src.Len(), u8);
+}
+
+static bool TzU8ToMB(const AString &u8, UINT codePage, AString &mb)
+{
+  const char *name = NULL;
+  if (!TzIconvName(codePage, name))
+    return false;
+  return TzIconvConvert("UTF-8", name, u8.Ptr(), u8.Len(), mb);
+}
