<?xml version="1.0" encoding="UTF-8"?>
<CONFIG>
  <ProjectOptions>
    <Version Value="12"/>
    <General>
      <Flags>
        <MainUnitHasTitleStatement Value="False"/>
      </Flags>
      <Title Value="TyZip"/>
      <Scaled Value="True"/>
    </General>
    <BuildModes Active="Default">
      <!-- Default is the debug/test build: lib/<cpu>-<os>/TyZip, assembled into
           bin/ for local testing. Release writes its executable and units to
           dist/<cpu>-<os>/; scripts/release.sh assembles dist/TyZip.app and the
           distributable zips from it. A build mode only carries the values that
           differ from compiler defaults (it does not inherit the project
           CompilerOptions below), so -WM11.0 has to be repeated here.
           OptimizationLevel 3 = -O3, GenerateDebugInfo False = no -g. No
           StripSymbols here: FPC's -Xs does not strip on Darwin, so
           package_app.sh STRIP=1 strips the bundled executable instead. -->
      <Item Name="Default" Default="True"/>
      <Item Name="Release">
        <CompilerOptions>
          <Version Value="11"/>
          <SearchPaths>
            <OtherUnitFiles Value="src;backend"/>
            <UnitOutputDirectory Value="dist/$(TargetCPU)-$(TargetOS)"/>
          </SearchPaths>
          <CodeGeneration>
            <Optimizations>
              <OptimizationLevel Value="3"/>
            </Optimizations>
          </CodeGeneration>
          <Linking>
            <Debugging>
              <GenerateDebugInfo Value="False"/>
              <DebugInfoType Value="dsAuto"/>
            </Debugging>
            <Options>
              <Win32>
                <GraphicApplication Value="True"/>
              </Win32>
            </Options>
          </Linking>
          <Other>
            <CustomOptions Value="-WM11.0"/>
          </Other>
        </CompilerOptions>
      </Item>
    </BuildModes>
    <PublishOptions>
      <Version Value="2"/>
    </PublishOptions>
    <RunParams>
      <FormatVersion Value="2"/>
    </RunParams>
    <RequiredPackages>
      <Item>
        <PackageName Value="LCL"/>
      </Item>
      <Item>
        <PackageName Value="tycontrols"/>
      </Item>
      <Item>
        <PackageName Value="SynEdit"/>
      </Item>
    </RequiredPackages>
